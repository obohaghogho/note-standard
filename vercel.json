{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": null,
  "routes": [
    { "src": "/(sitemap\\.xml)", "dest": "/$1" },
    { "src": "/(robots\\.txt)", "dest": "/$1" },
    { "src": "/(fincra-verification\\.txt)", "dest": "/$1" },
    { "src": "/.well-known/(.*)", "dest": "/.well-known/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

