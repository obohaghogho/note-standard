{
  "buildCommand": "npm run build --workspace=client",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "vite",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.notestandard.com"
        }
      ],
      "status": 301,
      "headers": { "Location": "https://notestandard.com/$1$is_args$args" }
    },
    { "src": "/(sitemap\\.xml)", "dest": "/$1" },
    { "src": "/(robots\\.txt)", "dest": "/$1" },
    { "src": "/(fincra-verification\\.txt)", "dest": "/$1" },
    { "src": "/.well-known/(.*)", "dest": "/.well-known/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}

